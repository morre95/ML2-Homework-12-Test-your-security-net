{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-start.sh",
        "timeout": 10
      }
    ],
    "sessionEnd": [
      {
        "command": ".cursor/hooks/session-end.sh",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/guard-shell.py",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/guard-mcp.sh",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/guard-tools.py",
        "matcher": "Write|StrReplace|Edit|Delete",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": ".cursor/hooks/guard-read.py",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/write-format.sh",
        "timeout": 30
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/lsp-check.sh",
        "matcher": "Write|StrReplace|Edit",
        "timeout": 60
      }
    ]
  }
}
